<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The real theming is done by Compose (see presentation/theme). This exists
      so the window background matches the app before the first frame renders,
      which is what stops the launch flash.
    -->
    <style name="Theme.John" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
